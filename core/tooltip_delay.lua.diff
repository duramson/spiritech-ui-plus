--- a/UI/Packages/Core/tooltip_delay.lua
+++ b/UI/Packages/Core/tooltip_delay.lua
@@ -0,0 +1,158 @@
+-- Tooltips that wait for the pointer to rest, as in the original client. Spiritech shows a tooltip the moment the
+-- pointer touches a view, so sweeping it over the shortcut bars or a grid pops one up after another; the original
+-- client showed one only once the pointer had rested on its view for about a second. The client has no delay of its
+-- own, so this keeps the text a package sets through ui.tooltip to itself and hands it to the client only once the
+-- pointer has rested on the view for DELAY milliseconds. The client then shows it, and hides it when the pointer
+-- leaves, as before. Where the client draws a tooltip of its own for a view (a shortcut's description), the text
+-- still switches it on and off, so that one waits too.
+--
+-- Core loads this right after ui.lua, in every package's VM, before any script keeps ui.tooltip for itself. It learns
+-- of the pointer over a view through ui.on_pointer ("hover") and of time passing through the package's update
+-- observer (ui.on_update). The client keeps one of each per view and per package, so those are wrapped as well, and
+-- the package's own observers keep working beside these. The client reports no pointer leaving a view, only one
+-- coming over another: a pointer that leaves a view for anything but another of the package's tooltips (the world, a
+-- window's background, another window) and comes straight back finds its tooltip already there.
+--
+-- Tooltips that don't pass through Lua keep showing at once: those a layout file sets (the tooltip attribute) and the
+-- client's own, such as the item descriptions in the inventory, the bank and the Wear window.
+do
+	local DELAY = 1000 -- milliseconds; 0 shows tooltips at once, as Spiritech does
+
+	if DELAY > 0 then
+		local set_tooltip, observe_pointer = ui.tooltip, ui.on_pointer
+		local observe_updates, stop_updates, destroy = ui.on_update, ui.stop_updates, ui.destroy
+
+		local wanted = {} -- view -> the text the package set
+		local given = {} -- view -> the text the client has
+		local shown = {} -- view -> true once the pointer has rested on it: its text goes to the client
+		local watched = {} -- view -> true once the hover observer is in place, false where the client refused it
+		local observers = {} -- view -> the package's own pointer observer
+		local hovered, entered -- the view the pointer was over last, and when it got there
+		local own_update, waiting -- the package's update observer, and whether a tooltip waits for the delay
+		local update
+
+		local function give(view, text)
+			if given[view] ~= text then
+				given[view] = text
+				set_tooltip(view, text)
+			end
+		end
+
+		local function wait()
+			if not waiting then
+				waiting = true
+				observe_updates(update)
+			end
+		end
+
+		local function stop_waiting()
+			if waiting then
+				waiting = false
+				if not own_update then
+					stop_updates()
+				end
+			end
+		end
+
+		function update(now)
+			if waiting and now - entered >= DELAY then
+				stop_waiting()
+				local text = hovered and wanted[hovered]
+				if text and text ~= "" then
+					shown[hovered] = true
+					give(hovered, text)
+				end
+			end
+			if own_update then
+				own_update(now)
+			end
+		end
+
+		-- The pointer is over a view: the tooltip of the one before goes back into hiding, and this one's waits.
+		local function hover(view)
+			if view == hovered then
+				return
+			end
+			if hovered then
+				shown[hovered] = nil
+				if wanted[hovered] then
+					give(hovered, "")
+				end
+			end
+			hovered, entered = view, ui.time()
+			if wanted[view] and wanted[view] ~= "" then
+				wait()
+			else
+				stop_waiting()
+			end
+		end
+
+		local function observer(view)
+			return function(phase, x, y)
+				if phase == "hover" then
+					hover(view)
+				end
+				local own = observers[view]
+				if own then
+					return own(phase, x, y)
+				end
+			end
+		end
+
+		local function watch(view)
+			if watched[view] == nil then
+				local placed = pcall(observe_pointer, view, observer(view))
+				-- Refused in combat, the observer is tried again at the next change; refused otherwise, the view's
+				-- tooltips show at once.
+				if placed or not ui.in_combat() then
+					watched[view] = placed
+				end
+			end
+			return watched[view]
+		end
+
+		function ui.tooltip(view, text)
+			if not watch(view) then
+				given[view] = text
+				return set_tooltip(view, text)
+			end
+			wanted[view] = text
+			if text == nil or text == "" or shown[view] then
+				give(view, text)
+			else
+				give(view, "")
+				if view == hovered then
+					wait()
+				end
+			end
+		end
+
+		function ui.on_pointer(view, callback)
+			observers[view] = callback
+			if not watched[view] then
+				return observe_pointer(view, callback)
+			end
+		end
+
+		function ui.on_update(callback)
+			own_update = callback
+			return observe_updates(update)
+		end
+
+		function ui.stop_updates()
+			own_update = nil
+			if not waiting then
+				return stop_updates()
+			end
+		end
+
+		function ui.destroy(view)
+			wanted[view], given[view], shown[view], watched[view], observers[view] = nil, nil, nil, nil, nil
+			if view == hovered then
+				hovered = nil
+				stop_waiting()
+			end
+			return destroy(view)
+		end
+	end
+end
