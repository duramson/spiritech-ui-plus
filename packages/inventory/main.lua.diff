+-- The slots as far from the window's frame as in the original client: their outlines 5 pixels clear of its left and
+-- right lines and 4 under the title's line (window.xml), and with the scroll bar 4 from it, the bar a pixel short of
+-- the right line. Grid.size counts Spiritech's: 4 pixels on either side, 5 under the title and 12 for the bar.
+local function slot_sizing(maximum)
+	local slots = Grid.slots(maximum)
+	function slots:size(columns, rows, scrollbar)
+		local width, height = Grid.size(self, columns, rows, scrollbar)
+		return width + (scrollbar and 1 or 2), height - 1
+	end
+	-- Grid.resolve, but only with as many columns as divide the slots, from the fewest the window allows: every row
+	-- full, with no empty space after the last slot (30 slots: 1, 2, 3, 5, 6, 10, 15 or 30 across, never 7 by 5).
+	-- Grid.resolve takes any column count and caps the rows at what the slots need, so most widths left the last
+	-- row short.
+	function slots:resolve(width, height, content_count, fewest_columns)
+		local step = self.cell + self.spacing
+		local distance = math.huge
+		local chosen_width, chosen_height, chosen_columns, chosen_rows
+		for columns = math.min(fewest_columns or 1, self.maximum), self.maximum do
+			if self.maximum % columns == 0 then
+				local fitting = math.floor((height - 36 + self.spacing) / step + 0.5)
+				local rows = math.max(1, math.min(math.floor(self.maximum / columns), fitting))
+				local candidate_width, candidate_height = self:size(columns, rows, content_count > columns * rows)
+				local candidate_distance = math.abs(candidate_width - width)
+				if candidate_distance < distance then
+					distance = candidate_distance
+					chosen_width, chosen_height = candidate_width, candidate_height
+					chosen_columns, chosen_rows = columns, rows
+				end
+			end
+		end
+		return chosen_width, chosen_height, chosen_columns, chosen_rows
+	end
+	return slots
+end
+local sizing = slot_sizing(capacity)
