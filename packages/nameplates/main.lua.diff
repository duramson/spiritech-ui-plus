+-- UI+: the original client writes the names over the heads in Verdana at 13 px, in pixels, a pixel further apart
+-- than in its windows and without an outline, into a texture as large as the 128 x 32 selection brackets; this
+-- package's layout is already that one (baseline 11, the bar 64 x 4 at 14), so one pixel of the plate is one of those
+-- pixels. glyphs.lua holds those pixels when the installer could make them from the Verdana on the player's computer
+-- (fonts/pixelfont.py, with Notum Grotesk). Each run of pixels is drawn as a rectangle. Without the table, and for a
+-- text with a character it lacks, Spiritech's own font draws it as before.
+local pixel_font = UIPLUS_PIXEL_FONT
+local byte, floor = string.byte, math.floor
+
+local glyph_cache = {}
+
+local function glyph(size, code)
+    local cache = glyph_cache[size]
+    if not cache then
+        cache = {}
+        glyph_cache[size] = cache
+    end
+    local found = cache[code]
+    if found == nil then
+        local source = pixel_font[size][code]
+        found = false
+        if source then
+            local rects = {}
+            for i = 2, #source do
+                rects[i - 1] = byte(source, i) - 64
+            end
+            found = { advance = byte(source, 1) - 64, rects = rects }
+        end
+        cache[code] = found
+    end
+    return found
+end
+
+-- The text's characters as code points, or nil when it isn't UTF-8.
+local function code_points(text)
+    local codes, i, n = {}, 1, #text
+    while i <= n do
+        local c = byte(text, i)
+        local code, length
+        if c < 0x80 then
+            code, length = c, 1
+        elseif c >= 0xC2 and c < 0xE0 then
+            code, length = c - 0xC0, 2
+        elseif c >= 0xE0 and c < 0xF0 then
+            code, length = c - 0xE0, 3
+        elseif c >= 0xF0 and c < 0xF5 then
+            code, length = c - 0xF0, 4
+        else
+            return nil
+        end
+        for k = 1, length - 1 do
+            local continuation = byte(text, i + k)
+            if not continuation or continuation < 0x80 or continuation > 0xBF then
+                return nil
+            end
+            code = code * 64 + continuation - 0x80
+        end
+        codes[#codes + 1] = code
+        i = i + length
+    end
+    return codes
+end
+
+-- A text set in pixels: its rectangles from the pen's start on the baseline (x, y, width, height, y down) and the
+-- extent of its ink. Kept per text and size, as the plates draw the same names every frame.
+local runs, run_count = {}, 0
+
+local function pixel_run(text, size)
+    if not pixel_font then
+        return false
+    end
+    size = floor(size + 0.5)
+    if not pixel_font[size] then
+        return false
+    end
+    local of_size = runs[size]
+    if not of_size then
+        of_size = {}
+        runs[size] = of_size
+    end
+    local run = of_size[text]
+    if run ~= nil then
+        return run
+    end
+    if run_count >= 512 then
+        runs, run_count = { [size] = {} }, 0
+        of_size = runs[size]
+    end
+    run = false
+    local codes = code_points(text)
+    if codes then
+        local rects, pen, left, right, top, bottom = {}, 0, nil, nil, 0, 0
+        local complete = true
+        for _, code in ipairs(codes) do
+            local g = glyph(size, code)
+            if not g then
+                complete = false
+                break
+            end
+            local source = g.rects
+            for i = 1, #source, 4 do
+                local x, y, w, h = pen + source[i], source[i + 1], source[i + 2], source[i + 3]
+                rects[#rects + 1] = x
+                rects[#rects + 1] = y
+                rects[#rects + 1] = w
+                rects[#rects + 1] = h
+                left = left and math.min(left, x) or x
+                right = right and math.max(right, x + w) or x + w
+                top = math.min(top, y)
+                bottom = math.max(bottom, y + h)
+            end
+            pen = pen + g.advance
+        end
+        if complete then
+            run = { rects = rects, left = left or 0, right = right or 0, top = top, bottom = bottom }
+        end
+    end
+    of_size[text] = run
+    run_count = run_count + 1
+    return run
+end
+
+-- Rectangles of pixel text drawn this frame, counted while the clock reads the same millisecond.
+local frame_time, frame_rects, clock = nil, 0, true
+
+local function within_budget(run)
+    if not clock then
+        return true
+    end
+    local ok, now = pcall(ui.time)
+    if not ok then
+        clock = false
+        return true
+    end
+    if now ~= frame_time then
+        frame_time, frame_rects = now, 0
+    end
+    frame_rects = frame_rects + #run.rects / 4
+    return frame_rects <= style.pixel_budget
+end
+
+local function text_width(text, size, run)
+    if run then
+        return run.right - run.left
+    end
+    return canvas.measure(text, size, "width")
+end
+
+local function text_ascent(text, size, run)
+    if run then
+        return -run.top
+    end
+    return canvas.measure(text, size, "ascent") + style.outline / 2
+end
+
+-- Where the text's ink ends below its baseline.
+local function text_bottom(text, size, baseline, run)
+    if run then
+        return baseline + run.bottom
+    end
+    return baseline - canvas.measure(text, size, "descent") + style.outline / 2
+end
+
+local function draw_text(text, x, baseline, size, color, run)
+    if run and within_budget(run) then
+        local left = floor(x - (run.left + run.right) / 2 + 0.5)
+        local top = floor(baseline + 0.5)
+        local rects = run.rects
+        for i = 1, #rects, 4 do
+            canvas.rectangle(left + rects[i], top + rects[i + 1], rects[i + 2], rects[i + 3], color)
+        end
+    else
+        canvas.text(text, x, baseline, size, color, style.outline)
+    end
+end
 
