+-- UI+: screen pixels per pixel of the interface: two on a Retina screen or at 200 % display scaling, else one.
+local function interface_pixels()
+    local ok, scale = pcall(ui.pixel_scale_y)
+    if ok and type(scale) == "number" and scale >= 1 then
+        return floor(scale + 0.5)
+    end
+    return 1
+end
+
+-- UI+: a whole number of screen pixels for each pixel of the plate, so pixel text stays crisp at every distance
+-- instead of drawing some of its pixels a screen pixel wider than others. Rounded, and never below one pixel of the
+-- interface, so on a Retina screen a far plate's letters keep the original's pixel size (2 x 2, as in Notum Grotesk
+-- 200) instead of coming out half as fine; `fit` rounds down, for a plate that has to fit under the top of the screen.
+local function whole_pixels(world_scale, pixels_per_unit, fit)
+    local screen_pixels = world_scale * pixels_per_unit
+    if screen_pixels <= 0 then
+        return world_scale
+    end
+    local whole = fit and floor(screen_pixels) or floor(screen_pixels + 0.5)
+    return math.max(interface_pixels(), whole) / pixels_per_unit
 end
 
