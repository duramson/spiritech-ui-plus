+-- The map's surface keeps the wheel to itself, so an empty scroll view lies over it, padded above and below: the
+-- wheel scrolls that, and each frame turns how far it went into zoom steps and puts it back to the middle. It takes
+-- the presses as well, so it drags the map and opens its menu itself.
+local REST, NOTCH = 1000, 35.1
+local fill_width, fill_height = 0, 0
+local settled = false
+local turns = 0
+local pointer_x, pointer_y
+local drag
+
+local function pointer_anchor()
+	if not pointer_x then
+		return nil, nil
+	end
+	return pointer_x - ui.x(surface), pointer_y - ui.y(surface)
+end
+
+ui.on_pointer(over, function(phase, x, y)
+	if phase == "hover" or phase == "start" or phase == "move" then
+		pointer_x, pointer_y = x, y
+	end
+	if phase == "start" then
+		ui.capture_pointer(over)
+		drag = { x = x, y = y, pan_x = view.read("x"), pan_y = view.read("y") }
+	elseif phase == "move" and drag then
+		local per_pixel = view.read("width") / math.max(1, ui.width(surface))
+		view.pan(drag.pan_x - (x - drag.x) * per_pixel, drag.pan_y - (y - drag.y) * per_pixel)
+	elseif phase == "end" or phase == "cancel" then
+		drag = nil
+	end
+end)
+
+ui.on_pointer_release(over, "right", function()
+	if opened and pointer_x then
+		compose_menu(context_menu)
+		ui.menu.show_at(context_menu, pointer_x, pointer_y)
+	end
+end)
+
+ui.on_update(function()
+	local width, height = ui.width(over), ui.height(over)
+	if width <= 0 or height <= 0 then
+		return
+	end
+	if width ~= fill_width or height ~= fill_height then
+		fill_width, fill_height = width, height
+		ui.size(over_fill, width, height)
+		settled = false
+	end
+	local offset = ui.scroll_offset(over)
+	if offset ~= REST then
+		ui.scroll_to(over, REST)
+		if settled then
+			-- Turning the wheel away from you scrolls up and zooms in.
+			turns = turns - (offset - REST) / NOTCH
+			local steps = turns < 0 and math.ceil(turns - 0.001) or math.floor(turns + 0.001)
+			turns = turns - steps
+			if steps ~= 0 then
+				-- From a level a bound cut short, the first step goes to the next whole one.
+				local from = steps > 0 and math.floor(level + 0.001) or math.ceil(level - 0.001)
+				set_level(from + steps, pointer_anchor())
+			end
+		end
+	else
+		settled = true
+	end
+end)
